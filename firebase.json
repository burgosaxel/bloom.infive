{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.log",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/momlybyange",
        "destination": "/momlybyange/index.html"
      },
      {
        "source": "/api/subscribeLeadMagnet",
        "function": "subscribeLeadMagnet"
      },
      {
        "source": "/api/adminLeadMagnetSequence",
        "function": "adminLeadMagnetSequence"
      },
      {
        "source": "/unsubscribe",
        "function": "unsubscribe"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "host": "0.0.0.0",
      "port": 4173
    }
  }
}
